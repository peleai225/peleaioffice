# Copier vers .env.local (non versionné) et renseigner les valeurs.

# URL publique du site, sans slash final (SEO, sitemap, Open Graph, canoniques).
# Si vide : https://peleai.online en production, l'URL de prévisualisation sur Vercel, localhost en dev.
NEXT_PUBLIC_SITE_URL=https://peleai.online

# Formulaire de contact (Server Action → API Resend). Sans ces trois valeurs, le formulaire
# affiche un message invitant à écrire sur WhatsApp.
# Clé API : https://resend.com/api-keys — le domaine d'envoi doit être vérifié dans Resend.
RESEND_API_KEY=
# Adresse qui reçoit les demandes.
CONTACT_TO_EMAIL=
# Expéditeur, sur le domaine vérifié. Exemple : PeleAI <site@peleai.online>
CONTACT_FROM_EMAIL=

# Vérification des moteurs de recherche (facultatif si la vérification se fait par DNS, recommandé).
# Google Search Console → méthode « Balise HTML » → valeur de l'attribut content.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → méthode « Balise meta » → valeur de msvalidate.01.
BING_SITE_VERIFICATION=

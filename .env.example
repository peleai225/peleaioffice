# Copier vers .env.local (non versionné) et renseigner les valeurs.

# URL publique du site, sans slash final (SEO, sitemap, Open Graph, canoniques).
# Sur Vercel, si vide, VERCEL_URL est utilisée au build.
# Exemple : https://www.peleai.ci
NEXT_PUBLIC_SITE_URL=

# Formulaire de contact (Server Action → API Resend). Sans ces trois valeurs, le formulaire
# affiche un message invitant à écrire sur WhatsApp.
# Clé API : https://resend.com/api-keys — le domaine d'envoi doit être vérifié dans Resend.
RESEND_API_KEY=
# Adresse qui reçoit les demandes.
CONTACT_TO_EMAIL=
# Expéditeur, sur le domaine vérifié. Exemple : PeleAI <site@peleai.ci>
CONTACT_FROM_EMAIL=
